@echo off
REM ============================================================
REM scaffold.bat - idempotent project skeleton
REM
REM Usage:
REM   tools\scaffold.bat        -> create in project root (parent of tools\)
REM   tools\scaffold.bat my-app -> create in .\my-app
REM   tools\scaffold.bat X:\p   -> explicit absolute path
REM
REM Rule: existing files and folders are NEVER overwritten.
REM Root is auto-detected from this script's location via %~dp0,
REM so it works after cloning to any path (no hardcoded C:\).
REM ============================================================

REM If no argument: use parent of the folder containing this script.
REM %%~fI resolves to a full path, so "tools\.." becomes the project root.
if "%~1"=="" (
    for %%I in ("%~dp0..") do set "ROOT=%%~fI"
) else (
    for %%I in ("%~1") do set "ROOT=%%~fI"
)

echo.
echo === Scaffold target: %ROOT% ===
echo.

REM ---------- Root ----------
call :mkdirs "%ROOT%"
call :mkdirs "%ROOT%\.github\workflows"
call :touch  "%ROOT%\.gitignore"
call :touch  "%ROOT%\.env.example"
call :touch  "%ROOT%\docker-compose.yml"
call :touch  "%ROOT%\README.md"
call :touch  "%ROOT%\spec.md"
call :touch  "%ROOT%\devlog.md"

REM ---------- Backend ----------
call :mkdirs "%ROOT%\backend"
call :touch  "%ROOT%\backend\pyproject.toml"
call :touch  "%ROOT%\backend\Dockerfile"

call :mkdirs "%ROOT%\backend\app"
call :touch  "%ROOT%\backend\app\__init__.py"
call :touch  "%ROOT%\backend\app\main.py"
call :touch  "%ROOT%\backend\app\config.py"
call :touch  "%ROOT%\backend\app\db.py"
call :touch  "%ROOT%\backend\app\log_setup.py"

call :mkdirs "%ROOT%\backend\app\models"
call :touch  "%ROOT%\backend\app\models\__init__.py"

call :mkdirs "%ROOT%\backend\app\schemas"
call :touch  "%ROOT%\backend\app\schemas\__init__.py"

call :mkdirs "%ROOT%\backend\app\api"
call :touch  "%ROOT%\backend\app\api\__init__.py"

call :mkdirs "%ROOT%\backend\app\core"
call :touch  "%ROOT%\backend\app\core\__init__.py"

call :mkdirs "%ROOT%\backend\app\tests"
call :touch  "%ROOT%\backend\app\tests\__init__.py"

call :mkdirs "%ROOT%\backend\alembic"
call :touch  "%ROOT%\backend\alembic\env.py"
call :touch  "%ROOT%\backend\alembic\script.py.mako"
call :touch  "%ROOT%\backend\alembic.ini"

REM ---------- Frontend ----------
REM frontend/ is intentionally NOT created here: it will be generated by
REM   npm create vite@latest frontend -- --template react-ts
REM If the folder already exists and is non-empty, Vite refuses to run.
REM Subfolders src/{pages,components,api,i18n} are added after the Vite
REM scaffold (step 6).

echo.
echo === Done. Existing files were left untouched. ===
echo.
echo Reminder: fill the empty config files with content from the Day 1 message:
echo   pyproject.toml, Dockerfile, docker-compose.yml, .env.example,
echo   .gitignore, app\main.py
echo Leave these two empty on purpose:
echo   backend\app\__init__.py, backend\app\tests\__init__.py
echo.

endlocal
goto :eof

REM ============================================================
REM :mkdirs "path" - create folder only if it does not exist
REM ============================================================
:mkdirs
if not exist "%~1\" (
    mkdir "%~1"
    if errorlevel 1 (
        echo [FAIL]  %~1
    ) else (
        echo [mkdir] %~1
    )
) else (
    echo [skip]  %~1
)
goto :eof

REM ============================================================
REM :touch "path" - create empty file only if it does not exist
REM ============================================================
:touch
if not exist "%~1" (
    type nul > "%~1"
    if errorlevel 1 (
        echo [FAIL]  %~1
    ) else (
        echo [file]  %~1
    )
) else (
    echo [skip]  %~1
)
goto :eof
